<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.example.chatdesktop.controller.ChatController"
        styleClass="chat-background">

    <!-- TOPO -->

    <top>

        <HBox
                spacing="15"
                alignment="CENTER_LEFT"
                styleClass="top-bar">

            <VBox
                    spacing="5"
                    HBox.hgrow="ALWAYS">

                <Label
                        text="🌀 NARUTO AI"
                        styleClass="titulo"/>

                <Label
                        text="Assistente inteligente • Groq"
                        styleClass="modelo"/>

            </VBox>

            <Button
                    fx:id="botaoNovaConversa"
                    text="✦ Nova conversa"
                    onAction="#novaConversa"
                    styleClass="new-chat-button"/>

        </HBox>

    </top>


    <!-- CHAT -->

    <center>

        <TextArea
                fx:id="areaChat"
                editable="false"
                wrapText="true"
                promptText="A conversa aparecerá aqui..."
                styleClass="chat-area"/>

    </center>


    <!-- CAMPO DE MENSAGEM -->

    <bottom>

        <HBox
                spacing="10"
                alignment="CENTER"
                styleClass="input-container">

            <padding>

                <Insets
                        top="15"
                        right="15"
                        bottom="15"
                        left="15"/>

            </padding>

            <TextField
                    fx:id="campoMensagem"
                    promptText="Digite sua mensagem..."
                    HBox.hgrow="ALWAYS"
                    onAction="#enviarMensagem"
                    styleClass="message-input"/>

            <Button
                    fx:id="botaoEnviar"
                    text="Enviar ➤"
                    prefWidth="110"
                    onAction="#enviarMensagem"
                    styleClass="send-button"/>

        </HBox>

    </bottom>

</BorderPane>