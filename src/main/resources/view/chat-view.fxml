<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.chatdesktop.controller.ChatController"
        styleClass="root">

    <!-- ================================================= -->
    <!-- BARRA LATERAL -->
    <!-- ================================================= -->

    <left>

        <VBox
                fx:id="sidebar"
                prefWidth="230"
                spacing="18"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="18"
                        right="16"
                        bottom="16"
                        left="16"/>
            </padding>


            <!-- NOVA CONVERSA -->

            <Button
                    fx:id="botaoNovaConversa"
                    text="✦  Nova conversa"
                    prefHeight="42"
                    maxWidth="Infinity"
                    onAction="#novaConversa"
                    styleClass="new-chat-button"/>


            <!-- TÍTULO HISTÓRICO -->

            <Label
                    text="◷  HISTÓRICO"
                    styleClass="history-title"/>


            <!-- HISTÓRICO -->

            <ListView
                    fx:id="listaHistorico"
                    VBox.vgrow="ALWAYS"
                    styleClass="history-list"/>


            <!-- OPÇÕES -->

            <Button
                    fx:id="botaoOpcoes"
                    text="⚙  Opções"
                    prefHeight="42"
                    maxWidth="Infinity"
                    onAction="#abrirOpcoes"
                    styleClass="options-button"/>

        </VBox>

    </left>


    <!-- ================================================= -->
    <!-- ÁREA PRINCIPAL -->
    <!-- ================================================= -->

    <center>

        <BorderPane
                styleClass="main-container">


            <!-- ================= TOPO ================= -->

            <top>

                <HBox
                        spacing="10"
                        alignment="CENTER_LEFT"
                        styleClass="header">

                    <VBox
                            spacing="2"
                            HBox.hgrow="ALWAYS">

                        <Label
                                text="Orbit-IA"
                                styleClass="title"/>

                        <Label
                                text="◉ Assistente inteligente • Groq"
                                styleClass="subtitle"/>

                    </VBox>


                    <!-- TEMA -->

                    <Button
                            fx:id="botaoTema"
                            text="☀"
                            prefWidth="48"
                            prefHeight="40"
                            onAction="#alternarTema"
                            styleClass="theme-button"/>

                </HBox>

            </top>


            <!-- ================= CHAT ================= -->

            <center>

                <ScrollPane
                        fx:id="chatScroll"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="chat-scroll">

                    <content>

                        <VBox
                                fx:id="chatContainer"
                                spacing="15"
                                fillWidth="true">

                            <padding>
                                <Insets
                                        top="22"
                                        right="28"
                                        bottom="22"
                                        left="28"/>
                            </padding>

                        </VBox>

                    </content>

                </ScrollPane>

            </center>


            <!-- ================= INPUT ================= -->

            <bottom>

                <HBox
                        spacing="12"
                        alignment="CENTER"
                        styleClass="input-container">

                    <padding>
                        <Insets
                                top="14"
                                right="18"
                                bottom="14"
                                left="18"/>
                    </padding>


                    <TextField
                            fx:id="campoMensagem"
                            promptText="Digite sua mensagem..."
                            HBox.hgrow="ALWAYS"
                            onAction="#enviarMensagem"
                            styleClass="message-input"/>


                    <Button
                            fx:id="botaoEnviar"
                            text="Enviar ➤"
                            prefWidth="115"
                            prefHeight="42"
                            onAction="#enviarMensagem"
                            styleClass="send-button"/>

                </HBox>

            </bottom>

        </BorderPane>

    </center>

</BorderPane>