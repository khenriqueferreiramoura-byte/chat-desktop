<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.chatdesktop.controller.ChatController"
        styleClass="root">

    <!-- =========================================================
         SIDEBAR
         ========================================================= -->

    <left>

        <VBox
                fx:id="sidebar"
                prefWidth="255"
                spacing="14"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="20"
                        right="16"
                        bottom="18"
                        left="16"/>
            </padding>

            <!-- LOGO -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="10"
                    styleClass="brand-container">

                <Label
                        text="✦"
                        styleClass="brand-icon"/>

                <VBox spacing="1">

                    <Label
                            text="Orbit-IA"
                            styleClass="brand-title"/>

                    <Label
                            text="AI Assistant"
                            styleClass="brand-subtitle"/>

                </VBox>

            </HBox>


            <!-- NOVA CONVERSA -->

            <Button
                    fx:id="botaoNovaConversa"
                    text="+  Nova conversa"
                    prefHeight="44"
                    maxWidth="Infinity"
                    onAction="#novaConversa"
                    styleClass="new-chat-button"/>


            <!-- HISTÓRICO -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="7"
                    styleClass="section-header">

                <Label
                        text="Conversas"
                        styleClass="history-title"/>

            </HBox>


            <ListView
                    fx:id="listaHistorico"
                    VBox.vgrow="ALWAYS"
                    styleClass="history-list"/>


            <!-- OPÇÕES -->

            <Button
                    fx:id="botaoOpcoes"
                    text="⚙  Opções"
                    prefHeight="42"
                    maxWidth="Infinity"
                    onAction="#abrirOpcoes"
                    styleClass="options-button"/>

        </VBox>

    </left>


    <!-- =========================================================
         ÁREA PRINCIPAL
         ========================================================= -->

    <center>

        <BorderPane
                styleClass="main-container">


            <!-- =================================================
                 HEADER
                 ================================================= -->

            <top>

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="12"
                        styleClass="header">

                    <VBox
                            spacing="3"
                            HBox.hgrow="ALWAYS">

                        <Label
                                text="Orbit-IA"
                                styleClass="title"/>

                        <Label
                                text="Seu assistente inteligente"
                                styleClass="subtitle"/>

                    </VBox>


                    <!-- BOTÃO DE TEMA -->

                    <Button
                            fx:id="botaoTema"
                            text="☼"
                            prefWidth="42"
                            prefHeight="42"
                            onAction="#alternarTema"
                            styleClass="theme-button"/>

                </HBox>

            </top>


            <!-- =================================================
                 CHAT
                 ================================================= -->

            <center>

                <ScrollPane
                        fx:id="chatScroll"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="chat-scroll">

                    <content>

                        <VBox
                                fx:id="chatContainer"
                                spacing="18"
                                fillWidth="true"
                                styleClass="chat-container">

                            <padding>
                                <Insets
                                        top="30"
                                        right="50"
                                        bottom="30"
                                        left="50"/>
                            </padding>

                        </VBox>

                    </content>

                </ScrollPane>

            </center>


            <!-- =================================================
                 CAMPO DE MENSAGEM
                 ================================================= -->

            <bottom>

                <VBox
                        styleClass="input-area">

                    <HBox
                            alignment="CENTER"
                            spacing="10"
                            styleClass="input-container">

                        <TextField
                                fx:id="campoMensagem"
                                promptText="Pergunte alguma coisa..."
                                HBox.hgrow="ALWAYS"
                                onAction="#enviarMensagem"
                                styleClass="message-input"/>

                        <Button
                                fx:id="botaoEnviar"
                                text="↑"
                                prefWidth="46"
                                prefHeight="46"
                                onAction="#enviarMensagem"
                                styleClass="send-button"/>

                    </HBox>

                    <Label
                            text="Orbit-IA pode cometer erros. Verifique informações importantes."
                            styleClass="input-hint"/>

                </VBox>

            </bottom>

        </BorderPane>

    </center>

</BorderPane>